      aria-label="Pedir por WhatsApp"
      class="fixed bottom-[max(5.5rem,calc(env(safe-area-inset-bottom)+5.5rem))] right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-gold text-coal shadow-[0_10px_40px_rgba(193,140,78,0.5)] transition hover:scale-105 hover:bg-gold-soft sm:bottom-5 sm:right-5"
    >
