    <!-- Drawer del pedido -->
    <div id="cart-backdrop" class="backdrop pointer-events-none fixed inset-0 z-40 bg-black/60 opacity-0 backdrop-blur-sm"></div>
    <aside
      id="cart-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Mi pedido"
      class="sheet fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col border-l border-gold/25 bg-coal-2"
    >
      <div class="flex items-center justify-between border-b border-cream/10 px-6 py-5">
        <h2 class="font-display text-2xl font-black">Mi pedido</h2>
        <button id="cart-close" class="rounded-full border border-cream/20 px-3 py-1.5 text-xs uppercase tracking-widest text-cream-dim transition hover:border-gold hover:text-gold" aria-label="Cerrar pedido">✕</button>
      </div>
      <ul id="cart-lines" class="flex-1 space-y-4 overflow-y-auto px-6 py-6"></ul>
      <div class="border-t border-cream/10 px-6 py-5">
        <div class="tnum flex items-center justify-between text-lg">
          <span class="text-cream-dim">Total</span>
          <span id="cart-total" class="tnum font-body text-2xl font-extrabold tracking-tight text-gold">$0</span>
        </div>
        <button
          id="cart-send"
          class="btn-gold mt-4 w-full rounded-full bg-gold py-4 text-[13px] font-bold uppercase tracking-[0.14em] text-coal transition hover:bg-gold-soft disabled:cursor-not-allowed disabled:opacity-40"
        >
          Enviar pedido por WhatsApp
