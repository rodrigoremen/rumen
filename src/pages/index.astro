                      {item.tech && <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-smoke">{item.tech}</p>}
                      {item.desc && <p class="mt-2 flex-1 text-[13px] leading-relaxed text-cream-dim">{item.desc}</p>}
                      <div class="tnum mt-4 flex flex-wrap gap-x-5 gap-y-1">
                        {item.prices.map((p) => (
                          <p class="text-sm text-cream-dim">
                            {p.k} <span class="font-body text-lg font-extrabold tracking-tight text-gold">${p.v}</span>
                          </p>
                        ))}
                      </div>
                      <button
                        data-order={JSON.stringify(item)}
                        class="order-btn btn-gold mt-5 w-full rounded-full border border-gold py-3 text-[12px] font-bold uppercase tracking-[0.16em] text-gold transition-all hover:bg-gold hover:text-coal hover:shadow-[0_0_28px_rgba(193,140,78,0.45)]"
                      >
                        {item.prices.length > 1 ? "Elegir" : "Agregar"} ＋
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
          <p class="mt-8 text-center text-[12px] uppercase tracking-[0.2em] text-smoke">Búfalo de rancho · Res seleccionada</p>
        </div>
      </section>

