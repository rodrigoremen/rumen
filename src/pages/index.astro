                      <div class="relative flex h-28 items-center justify-between overflow-hidden bg-coal-3 px-5">
                        <span class="font-display text-4xl font-black text-cream/15">N° {item.num}</span>
                        <span class="logo-mark block h-16 w-16 opacity-70 ring-1 ring-gold/30" aria-hidden="true">
