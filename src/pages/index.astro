    <!-- ══════════ SHEET DE MODIFICADORES ══════════ -->
    <div id="sheet-backdrop" class="backdrop pointer-events-none fixed inset-0 z-40 bg-black/70 opacity-0 backdrop-blur-sm"></div>
    <div
      id="sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sheet-name"
      class="sheet fixed inset-x-0 bottom-0 z-50 mx-auto max-h-[92svh] w-full max-w-2xl translate-y-full overflow-y-auto rounded-t-3xl border-t border-gold/30 bg-coal-2 px-6 pb-8 pt-6 sm:px-10"
    >
      <div id="sheet-grab" class="-mt-2 px-10 pb-3 pt-4" aria-hidden="true">
        <div class="mx-auto h-1.5 w-14 rounded-full bg-gold/60"></div>
      </div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p id="sheet-num" class="text-[11px] font-bold uppercase tracking-[0.3em] text-gold"></p>
          <h2 id="sheet-name" class="mt-1 font-display text-3xl font-black leading-tight"></h2>
          <p id="sheet-desc" class="mt-2 text-sm leading-relaxed text-cream-dim"></p>
        </div>
        <button id="sheet-close" class="shrink-0 rounded-full border border-cream/20 px-3 py-1.5 text-xs uppercase tracking-widest text-cream-dim transition hover:border-gold hover:text-gold" aria-label="Cerrar personalización">✕</button>
      </div>

      <fieldset class="mt-6">
        <legend class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">Presentación</legend>
        <div id="sheet-prices" class="mt-3 grid gap-2 sm:grid-cols-3"></div>
      </fieldset>

      <fieldset id="sheet-termino-wrap" class="mt-6">
        <legend class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">Término de la carne</legend>
        <div id="sheet-termino" class="mt-3 grid grid-cols-2 gap-2"></div>
        <p id="sheet-termino-note" class="mt-2 text-xs text-smoke"></p>
      </fieldset>

      <fieldset class="mt-6">
        <legend class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">
          Añadir extras <span class="text-smoke">· de la casa (demo)</span>
        </legend>
        <div id="sheet-extras" class="mt-3 grid gap-2 sm:grid-cols-2"></div>
      </fieldset>

      <div class="mt-7 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3" aria-label="Cantidad">
          <button id="qty-minus" class="h-11 w-11 rounded-full border border-cream/25 text-xl transition hover:border-gold hover:text-gold" aria-label="Quitar uno">−</button>
          <span id="qty-val" class="tnum w-6 text-center text-lg font-bold">1</span>
          <button id="qty-plus" class="h-11 w-11 rounded-full border border-cream/25 text-xl transition hover:border-gold hover:text-gold" aria-label="Agregar uno">＋</button>
        </div>
        <button
          id="sheet-add"
          class="btn-gold tnum flex-1 rounded-full bg-gold py-4 text-[13px] font-bold uppercase tracking-[0.14em] text-coal transition hover:bg-gold-soft"
        >
          Agregar · $0
        </button>
      </div>
    </div>

    <script>
      document.documentElement.classList.add("js");
      const WA_NUMBER = "525565366128";

      /* ── Reveal on scroll ── */
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("is-in")),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      /* ── Tabs de categorías ── */
      const tabs = [...document.querySelectorAll("#tabs [role=tab]")];
      const panels = [...document.querySelectorAll(".menu-cat")];
      tabs.forEach((t) =>
        t.addEventListener("click", () => {
          tabs.forEach((x) => {
            const on = x === t;
            x.setAttribute("aria-selected", String(on));
            x.className =
              "shrink-0 rounded-full border px-5 py-2.5 text-[12px] font-bold uppercase tracking-[0.14em] transition " +
              (on
                ? "border-gold bg-gold text-coal"
                : "border-cream/20 text-cream-dim hover:border-gold/60 hover:text-gold");
          });
          panels.forEach((p) => (p.hidden = p.dataset.catPanel !== t.dataset.cat));
        })
      );

      /* ── Pedido + modificadores ── */
      const EXTRAS = [
        { id: "tocino", name: "Tocino tostado", price: 25 },
        { id: "queso", name: "Queso extra", price: 20 },
        { id: "caram", name: "Cebolla caramelizada", price: 15 },
        { id: "salsa", name: "Salsa Rumen extra", price: 15 },
      ];
      const TERMINOS = ["3/4 jugoso", "Bien cocido"];

      const cart = [];
      let current = null;
      let selPrice = 0, selTermino = "", selExtras = new Set(), qty = 1;

      const sheet = document.getElementById("sheet");
      const sheetBackdrop = document.getElementById("sheet-backdrop");
      const cartDrawer = document.getElementById("cart-drawer");
      const cartBackdrop = document.getElementById("cart-backdrop");

      /* Bloqueo de scroll del fondo: una cuenta por capa abierta */
      let scrollLocks = 0;
      function lockScroll() {
        scrollLocks++;
        document.documentElement.classList.add("locked");
      }
      function unlockScroll() {
        scrollLocks = Math.max(0, scrollLocks - 1);
        if (!scrollLocks) document.documentElement.classList.remove("locked");
      }

      let sheetOpen = false;
      let cartOpen = false;
      function openSheet() {
        if (sheetOpen) return;
        sheetOpen = true;
        sheet.style.transform = "";
        sheet.classList.remove("translate-y-full");
        sheetBackdrop.classList.remove("opacity-0", "pointer-events-none");
        lockScroll();
        document.getElementById("sheet-close").focus();
      }
      function closeSheet() {
        if (!sheetOpen) return;
        sheetOpen = false;
        sheet.style.transform = "";
        sheet.classList.add("translate-y-full");
        sheetBackdrop.classList.add("opacity-0", "pointer-events-none");
        unlockScroll();
      }
      function openCart() {
        if (cartOpen) return;
        cartOpen = true;
        renderCart();
        cartDrawer.classList.remove("translate-x-full");
        cartBackdrop.classList.remove("opacity-0", "pointer-events-none");
        lockScroll();
      }
      function closeCart() {
        if (!cartOpen) return;
        cartOpen = false;
        cartDrawer.classList.add("translate-x-full");
        cartBackdrop.classList.add("opacity-0", "pointer-events-none");
        unlockScroll();
      }

      /* Arrastre hacia abajo para cerrar el sheet (desde el tirador) */
      const grab = document.getElementById("sheet-grab");
      let dragStartY = null;
      let dragDy = 0;
      grab.addEventListener("pointerdown", (e) => {
        dragStartY = e.clientY;
        dragDy = 0;
        sheet.classList.add("sheet-dragging");
        try { grab.setPointerCapture(e.pointerId); } catch (_) {}
      });
      grab.addEventListener("pointermove", (e) => {
        if (dragStartY === null) return;
        dragDy = Math.max(0, e.clientY - dragStartY);
        sheet.style.transform = "translateY(" + dragDy + "px)";
      });
      function endDrag() {
        if (dragStartY === null) return;
        dragStartY = null;
        sheet.classList.remove("sheet-dragging");
        if (dragDy > 110) closeSheet();
        else sheet.style.transform = "";
        dragDy = 0;
      }
      grab.addEventListener("pointerup", endDrag);
      grab.addEventListener("pointercancel", endDrag);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") { closeSheet(); closeCart(); }
      });
      sheetBackdrop.addEventListener("click", closeSheet);
      cartBackdrop.addEventListener("click", closeCart);
      document.getElementById("sheet-close").addEventListener("click", closeSheet);
      document.getElementById("cart-close").addEventListener("click", closeCart);
      document.getElementById("cart-fab").addEventListener("click", openCart);

      function money(n) { return "$" + n; }

      function refreshSheetTotal() {
        const extrasTotal = [...selExtras].reduce((a, id) => a + EXTRAS.find((x) => x.id === id).price, 0);
        const total = (selPrice + extrasTotal) * qty;
        document.getElementById("qty-val").textContent = qty;
        document.getElementById("sheet-add").textContent = "Agregar · " + money(total);
      }

      document.querySelectorAll(".order-btn").forEach((btn) =>
        btn.addEventListener("click", () => {
          current = JSON.parse(btn.dataset.order);
          selPrice = current.prices[0].v;
          selTermino = current.termino ? TERMINOS[0] : "";
          selExtras = new Set();
          qty = 1;

          document.getElementById("sheet-num").textContent = "N° " + current.num + (current.tech ? " · " + current.tech : "");
          document.getElementById("sheet-name").textContent = current.name;
          document.getElementById("sheet-desc").textContent = current.desc || "";

          const pw = document.getElementById("sheet-prices");
          pw.innerHTML = "";
          current.prices.forEach((p, i) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className =
              "rounded-xl border px-3 py-3 text-left transition " +
              (i === 0 ? "border-gold bg-gold/10" : "border-cream/15 hover:border-gold/50");
            b.innerHTML =
              "<span class='block text-[11px] uppercase tracking-[0.16em] text-cream-dim'>" + p.k + "</span>" +
              "<span class='tnum font-body text-xl font-extrabold tracking-tight text-gold'>$" + p.v + "</span>";
            b.setAttribute("aria-pressed", i === 0 ? "true" : "false");
            b.addEventListener("click", () => {
              selPrice = p.v;
              [...pw.children].forEach((c) => {
                c.className = "rounded-xl border px-3 py-3 text-left transition border-cream/15 hover:border-gold/50";
                c.setAttribute("aria-pressed", "false");
              });
              b.className = "rounded-xl border px-3 py-3 text-left transition border-gold bg-gold/10";
              b.setAttribute("aria-pressed", "true");
              refreshSheetTotal();
            });
            pw.appendChild(b);
          });

          const tw = document.getElementById("sheet-termino-wrap");
          if (current.termino) {
            tw.classList.remove("hidden");
            document.getElementById("sheet-termino-note").textContent = "";
            const tm = document.getElementById("sheet-termino");
            tm.innerHTML = "";
            TERMINOS.forEach((t, i) => {
              const b = document.createElement("button");
              b.type = "button";
              b.textContent = t;
              b.className =
                "rounded-xl border px-3 py-3 text-sm font-semibold transition " +
                (i === 0 ? "border-gold bg-gold/10 text-cream" : "border-cream/15 text-cream-dim hover:border-gold/50");
              b.setAttribute("aria-pressed", i === 0 ? "true" : "false");
              b.addEventListener("click", () => {
                selTermino = t;
                [...tm.children].forEach((c) => {
                  c.className = "rounded-xl border px-3 py-3 text-sm font-semibold transition border-cream/15 text-cream-dim hover:border-gold/50";
                  c.setAttribute("aria-pressed", "false");
                });
                b.className = "rounded-xl border px-3 py-3 text-sm font-semibold transition border-gold bg-gold/10 text-cream";
                b.setAttribute("aria-pressed", "true");
              });
              tm.appendChild(b);
            });
          } else {
            tw.classList.remove("hidden");
            document.getElementById("sheet-termino").innerHTML = "";
            document.getElementById("sheet-termino-note").textContent =
              current.id.includes("smash") || current.num <= 4
                ? "Sellado smash a fuego alto: cocción completa por técnica, con costra caramelizada."
                : "Este platillo no requiere término de cocción.";
          }

          const ew = document.getElementById("sheet-extras");
          ew.innerHTML = "";
          EXTRAS.forEach((x) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "flex items-center justify-between rounded-xl border border-cream/15 px-4 py-3 text-sm transition hover:border-gold/50";
            b.setAttribute("aria-pressed", "false");
            b.innerHTML =
              "<span>" + x.name + "</span><span class='tnum font-bold text-gold'>+$" + x.price + "</span>";
            b.addEventListener("click", () => {
              if (selExtras.has(x.id)) {
                selExtras.delete(x.id);
                b.className = "flex items-center justify-between rounded-xl border border-cream/15 px-4 py-3 text-sm transition hover:border-gold/50";
                b.setAttribute("aria-pressed", "false");
              } else {
                selExtras.add(x.id);
                b.className = "flex items-center justify-between rounded-xl border border-gold bg-gold/10 px-4 py-3 text-sm transition";
                b.setAttribute("aria-pressed", "true");
              }
              refreshSheetTotal();
            });
            ew.appendChild(b);
          });

          refreshSheetTotal();
          openSheet();
        })
      );

      document.getElementById("qty-minus").addEventListener("click", () => { if (qty > 1) { qty--; refreshSheetTotal(); } });
      document.getElementById("qty-plus").addEventListener("click", () => { if (qty < 12) { qty++; refreshSheetTotal(); } });

      document.getElementById("sheet-add").addEventListener("click", () => {
        if (!current) return;
        const extrasTotal = [...selExtras].reduce((a, id) => a + EXTRAS.find((x) => x.id === id).price, 0);
        const priceLabel = current.prices.find((p) => p.v === selPrice)?.k ?? "";
        cart.push({
          name: current.name,
          detail: [
            priceLabel,
            selTermino,
            [...selExtras].map((id) => EXTRAS.find((x) => x.id === id).name).join(", "),
          ].filter(Boolean).join(" · "),
          qty,
          unit: selPrice + extrasTotal,
        });
        closeSheet();
        renderCart();
        openCart();
      });

      function cartTotal() { return cart.reduce((a, l) => a + l.unit * l.qty, 0); }
      function cartCount() { return cart.reduce((a, l) => a + l.qty, 0); }

      function renderCart() {
        const ul = document.getElementById("cart-lines");
        ul.innerHTML = "";
        if (!cart.length) {
          ul.innerHTML = "<li class='rounded-xl border border-dashed border-cream/20 px-5 py-8 text-center text-sm text-smoke'>Tu pedido está vacío.<br />La plancha te espera en el menú.</li>";
        }
        cart.forEach((l, i) => {
          const li = document.createElement("li");
          li.className = "rounded-xl border border-cream/10 bg-coal px-4 py-3.5";
          li.innerHTML =
            "<div class='flex items-start justify-between gap-3'>" +
              "<div><p class='font-bold'>" + l.name + " <span class='tnum text-gold'>×" + l.qty + "</span></p>" +
              (l.detail ? "<p class='mt-1 text-xs text-smoke'>" + l.detail + "</p>" : "") + "</div>" +
              "<p class='tnum font-body text-lg font-extrabold tracking-tight text-gold'>$" + l.unit * l.qty + "</p>" +
            "</div>" +
            "<button class='mt-2 text-[11px] uppercase tracking-[0.18em] text-smoke transition hover:text-gold' data-rm='" + i + "'>Quitar</button>";
          ul.appendChild(li);
        });
        ul.querySelectorAll("[data-rm]").forEach((b) =>
          b.addEventListener("click", () => { cart.splice(Number(b.dataset.rm), 1); renderCart(); })
        );
        document.getElementById("cart-total").textContent = money(cartTotal());
        document.getElementById("cart-count").textContent = cartCount();
        document.getElementById("cart-total-fab").textContent = money(cartTotal());
        const fab = document.getElementById("cart-fab");
        const wasHidden = fab.classList.contains("hidden");
        fab.classList.toggle("hidden", !cart.length);
        fab.classList.toggle("flex", !!cart.length);
        if (wasHidden && cart.length) {
          fab.classList.remove("fab-show");
          void fab.offsetWidth;
          fab.classList.add("fab-show");
        }
        document.getElementById("cart-send").disabled = !cart.length;
      }

      document.getElementById("cart-clear").addEventListener("click", () => { cart.length = 0; renderCart(); });
      document.getElementById("cart-send").addEventListener("click", () => {
        if (!cart.length) return;
        const lines = cart.map((l) => "• " + l.qty + "× " + l.name + (l.detail ? " (" + l.detail + ")" : "") + " — $" + l.unit * l.qty);
        const msg = "Hola RUMEN, quiero pedir:\n" + lines.join("\n") + "\nTotal: $" + cartTotal() + "\nMi nombre: \nMi dirección: ";
        window.open("https://wa.me/" + WA_NUMBER + "?text=" + encodeURIComponent(msg), "_blank");
      });
      renderCart();
    </script>
  </body>
</html>
