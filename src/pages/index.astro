---
import "../styles/global.css";

const WA_NUMBER = "525565366128";
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent("Hola RUMEN, quiero hacer un pedido")}`;
const MENU_APP = "https://menurumen.netlify.app/";

type Price = { k: string; v: number };
type Item = {
  id: string;
  num: number;
  name: string;
  tech?: string;
  desc?: string;
  prices: Price[];
  badges?: { label: string; kind: "bufalo" | "insignia" | "limit" }[];
  img?: string;
  imgAlt?: string;
  termino?: boolean;
  featured?: boolean;
};

type Cat = { id: string; name: string; sub: string; items: Item[] };

const MENU: Cat[] = [
  {
    id: "smash",
    name: "Hamburguesas Smash",
    sub: "Carne prensada y sellada en plancha a fuego alto · doble smash, 125 g de proteína",
    items: [
      {
        id: "clasica-res", num: 1, name: "Clásica Smash de Res", tech: "Técnica smash",
        desc: "Doble smash, pan, queso americano fundido, pepinillos, salsa Rumen de la casa.",
        prices: [{ k: "Sola", v: 99 }, { k: "Combo", v: 149 }],
        img: "/img/clasica.jpg", imgAlt: "Clásica Smash con queso americano fundido y chile toreado",
      },
      {
        id: "clasica-bufalo", num: 2, name: "Clásica Smash de Búfalo", tech: "Técnica smash",
        desc: "Doble smash, pan, queso americano fundido, pepinillos, salsa Rumen de la casa. Búfalo de rancho.",
        prices: [{ k: "Sola", v: 179 }, { k: "Combo", v: 229 }],
        badges: [{ label: "Búfalo", kind: "bufalo" }, { label: "Hasta agotar existencia", kind: "limit" }],
        img: "/img/clasica.jpg", imgAlt: "Clásica Smash de búfalo con queso fundido",
      },
      {
        id: "rancho-res", num: 3, name: "La del Rancho de Res", tech: "Técnica smash",
        desc: "Doble smash, pan, doble salsa Rumen, tocino tostado, queso americano, cebolla morada, cebolla caramelizada, pepinillos, lechuga.",
        prices: [{ k: "Sola", v: 159 }, { k: "Combo", v: 209 }],
        img: "/img/rancho.jpg", imgAlt: "La del Rancho con tocino, cebolla morada y doble salsa Rumen",
      },
      {
        id: "rancho-bufalo", num: 4, name: "La del Rancho de Búfalo", tech: "Técnica smash",
        desc: "Doble smash, pan, doble salsa Rumen, tocino tostado, queso americano, cebolla morada, cebolla caramelizada, pepinillos, lechuga. Búfalo de rancho.",
        prices: [{ k: "Sola", v: 219 }, { k: "Combo", v: 269 }],
        badges: [{ label: "Búfalo", kind: "bufalo" }, { label: "Hasta agotar existencia", kind: "limit" }],
        img: "/img/rancho.jpg", imgAlt: "La del Rancho de búfalo con tocino y cebolla morada",
      },
    ],
  },
  {
    id: "hamburguesas",
    name: "Hamburguesas",
    sub: "Una sola carne, 125 g de proteína · elige el término",
    items: [
      {
        id: "rumeante-res", num: 5, name: "Rumeante Res",
        desc: "Pan, queso manchego y americano, cebolla caramelizada, lechuga, tomate, pepinillos, salsa Rumen de la casa.",
        prices: [{ k: "Sola", v: 145 }, { k: "Combo", v: 195 }],
        termino: true,
      },
      {
        id: "rumeante-bufalo", num: 6, name: "Rumeante Búfalo",
        desc: "Pan, queso manchego y americano, cebolla caramelizada, lechuga, tomate, pepinillos, salsa Rumen de la casa. Búfalo de rancho.",
        prices: [{ k: "Sola", v: 199 }, { k: "Combo", v: 249 }],
        badges: [
          { label: "Insignia de la casa", kind: "insignia" },
          { label: "Búfalo", kind: "bufalo" },
          { label: "Hasta agotar existencia", kind: "limit" },
        ],
        termino: true, featured: true,
        img: "/img/rancho.jpg", imgAlt: "Rumeante Búfalo, insignia de la casa",
      },
    ],
  },
  {
    id: "compartir",
    name: "Para compartir",
    sub: "Para acompañar o compartir",
    items: [
      {
        id: "papas-rumeantes", num: 7, name: "Papas Rumeantes",
        desc: "Papas grandes, búfalo molido, queso americano y manchego fundidos, salsa Rumen, tocino.",
        prices: [{ k: "Solas", v: 189 }, { k: "Con refresco", v: 209 }],
        badges: [{ label: "Hasta agotar existencia", kind: "limit" }],
        img: "/img/papas.jpg", imgAlt: "Papas Rumeantes con búfalo molido y salsa Rumen en empaque para llevar",
      },
      {
        id: "dedos", num: 8, name: "Dedos de Queso",
        desc: "Queso Monterey Jack fundido, costra de pan empanizado.",
        prices: [{ k: "4 pzs", v: 85 }, { k: "6 pzs", v: 125 }, { k: "8 pzs", v: 165 }],
      },
      {
        id: "papas", num: 9, name: "Papas a la Francesa",
        desc: "Corte delgado.",
        prices: [{ k: "Chica 80 g", v: 39 }, { k: "Mediana 120 g", v: 49 }, { k: "Grande 150 g", v: 59 }],
      },
    ],
  },
  {
    id: "bebidas",
    name: "Bebidas",
    sub: "Bien fríos",
    items: [
      {
        id: "coca", num: 10, name: "Coca-Cola 235 ml (vidrio)",
        prices: [{ k: "Pieza", v: 35 }],
      },
      {
        id: "lata", num: 11, name: "Refresco de lata 355 ml",
        desc: "Pepsi, Mirinda, 7Up o Manzanita.",
        prices: [{ k: "Pieza", v: 35 }],
      },
    ],
  },
];

const badgeStyle: Record<string, string> = {
  bufalo: "bg-gold text-coal",
  insignia: "border border-gold text-gold",
  limit: "border border-cream/25 text-cream-dim",
};

type Comp = { k: string; unit: string; b: number; r: number; d: string };

const VS_RES: Comp[] = [
  { k: "Grasa total", unit: "g", b: 2.5, r: 18, d: "La res se te queda pesando; aquí no hay grasa que te frene." },
  { k: "Colesterol", unit: "mg", b: 55, r: 85, d: "Menos colesterol que el corte de res equivalente." },
  { k: "Calorías", unit: "kcal", b: 140, r: 250, d: "Cerca de la mitad por el mismo bocado." },
  { k: "Proteína", unit: "g", b: 23, r: 21, d: "Rica en hierro, zinc y B12: rinde el día y la noche." },
];

const pct = (v: number, max: number) => Math.round((v / max) * 100);
const diff = (b: number, r: number) =>
  b >= r ? `+${Math.round((b / r - 1) * 100)}%` : `−${Math.round((1 - b / r) * 100)}%`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RUMEN · Búfalo de Origen — Dark Kitchen en Cuernavaca</title>
    <meta
      name="description"
      content="RUMEN, Dark Kitchen de carne de búfalo premium en Cuernavaca. Smash burgers, la insignia Rumeante Búfalo y papas rumeantes. Pide por WhatsApp."
    />
    <link rel="icon" type="image/png" href="/img/logo-cabeza.png" />
    <meta property="og:title" content="RUMEN · El Poder del Búfalo, Directo a tu Mesa" />
    <meta property="og:description" content="Carne de búfalo premium, magra y deliciosa. Dark Kitchen en Cuernavaca — solo delivery y take-out." />
    <meta property="og:image" content="/img/rancho.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Montserrat:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-coal text-cream font-body antialiased">
    <!-- ══════════ HEADER ══════════ -->
    <header class="fixed inset-x-0 top-0 z-40 border-b border-gold/15 bg-coal/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href="#top" class="flex items-center gap-3">
          <span class="logo-mark block h-10 w-10 shrink-0 ring-1 ring-gold/40" aria-hidden="false">
            <img src="/img/logo-cabeza.png" alt="Isotipo RUMEN — cabeza de búfalo dorada" />
          </span>
          <span class="leading-none">
            <span class="block font-display text-2xl font-black tracking-[0.08em]">RUMEN</span>
            <span class="block text-[10px] font-semibold uppercase tracking-[0.32em] text-gold">Búfalo de origen</span>
          </span>
        </a>
        <nav class="hidden items-center gap-7 text-[13px] font-medium uppercase tracking-[0.14em] text-cream-dim lg:flex" aria-label="Navegación principal">
          <a href="#bufalo" class="transition hover:text-gold">Por qué búfalo</a>
          <a href="#menu" class="transition hover:text-gold">Menú</a>
          <a href="#instagram" class="transition hover:text-gold">Instagram</a>
        </nav>
        <div class="flex items-center gap-2">
          <a
            href={MENU_APP}
            target="_blank"
            rel="noopener"
            class="hidden rounded-full px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.12em] text-cream-dim transition hover:text-gold sm:block"
          >
            Menú interactivo ↗
          </a>
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener"
            class="btn-gold whitespace-nowrap rounded-full border border-gold px-3 py-2 text-[11px] font-bold uppercase tracking-[0.1em] text-gold transition-all hover:bg-gold hover:text-coal hover:shadow-[0_0_28px_rgba(193,140,78,0.45)] sm:px-5 sm:py-2 sm:text-[12px] sm:tracking-[0.12em]"
          >
            Pide por WhatsApp
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <!-- ══════════ HERO ══════════ -->
      <section class="grain ember relative flex min-h-[100svh] items-end overflow-hidden">
        <img
          src="/img/rancho.jpg"
          alt="Hamburguesa La del Rancho de búfalo con tocino, cebolla morada y salsa Rumen"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-coal via-coal/55 to-coal/25"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-coal/80 via-transparent to-transparent"></div>

        <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 pt-36 sm:px-6 sm:pb-24">
          <p class="reveal mb-5 inline-flex items-center gap-2 rounded-full border border-gold/40 bg-coal/60 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.24em] text-gold backdrop-blur">
            <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-gold"></span>
            Dark Kitchen · Cuernavaca
          </p>
          <h1 class="reveal max-w-4xl font-display text-[13vw] font-black leading-[0.95] tracking-tight text-cream sm:text-7xl lg:text-8xl">
            El Poder del Búfalo,<br />
            <em class="font-light italic text-gold-soft">Directo a tu Mesa.</em>
          </h1>
          <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-cream-dim sm:text-lg">
            La carne premium, magra y deliciosa, cocinada en nuestra Dark Kitchen
            para una experiencia única en casa.
          </p>
          <div class="reveal mt-9 flex flex-wrap items-center gap-3">
            <a
              href="#menu"
              class="btn-gold rounded-full bg-gold px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-coal transition-all hover:bg-gold-soft hover:shadow-[0_0_40px_rgba(193,140,78,0.55)]"
            >
              Ver Menú Completo
            </a>
            <a
              href={WA_LINK}
              target="_blank"
              rel="noopener"
              class="rounded-full border border-cream/30 px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-cream transition hover:border-gold hover:text-gold"
            >
              Pide por WhatsApp
            </a>
          </div>
          <dl class="reveal mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-cream/10 pt-6 text-[12px] uppercase tracking-[0.18em] text-smoke">
            <div class="flex items-center gap-2"><dt class="text-gold">◆</dt><dd>Búfalo de rancho</dd></div>
            <div class="flex items-center gap-2"><dt class="text-gold">◆</dt><dd>Smash a fuego alto</dd></div>
            <div class="flex items-center gap-2"><dt class="text-gold">◆</dt><dd>Solo delivery y take-out</dd></div>
          </dl>
        </div>
      </section>

      <!-- ══════════ MARQUESINA ══════════ -->
      <div class="overflow-hidden border-y border-gold/25 bg-gold py-3" aria-hidden="true">
        <div class="marquee-track flex w-max items-center gap-8 whitespace-nowrap text-[13px] font-extrabold uppercase tracking-[0.3em] text-coal">
          {Array.from({ length: 2 }).map(() => (
            <span class="flex items-center gap-8">
              <span>Búfalo de origen</span><span>✦</span><span>Doble smash</span><span>✦</span>
              <span>Rumeante insignia</span><span>✦</span><span>Salsa Rumen de la casa</span><span>✦</span>
              <span>Cuernavaca</span><span>✦</span>
            </span>
          ))}
        </div>
      </div>

      <!-- ══════════ POR QUÉ BÚFALO ══════════ -->
      <section id="bufalo" class="relative mx-auto max-w-7xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
          <div class="reveal">
            <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-gold">Storytelling</p>
            <h2 class="mt-3 font-display text-4xl font-black leading-tight sm:text-5xl">
              ¿Por qué<br />Búfalo?
            </h2>
            <div class="mt-5 h-px w-24 bg-gold"></div>
            <p class="mt-5 max-w-md leading-relaxed text-cream-dim">
              No es res. Es una carne más magra, con carácter propio y un sabor
              profundo que la plancha smash convierte en costra caramelizada.
              La pruebas una vez y la res te sabe a trámite.
            </p>
            <p class="mt-4 max-w-md leading-relaxed text-cream-dim">
              Nuestro búfalo crece en rancho y llega a la cocina con su propia
              grasa mínima: lo que pones en la plancha es carne, no una mezcla
              con grasa de res. Por eso el sello es de verdad y el bocado se
              sostiene entero, sin caerse.
            </p>
            <img
              src="/img/logo-completo.png"
              alt="Logo RUMEN — Búfalo de origen"
              class="mt-8 w-52 rounded-xl border border-gold/20 object-cover opacity-90"
              loading="lazy"
            />
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="reveal rounded-2xl border border-cream/10 bg-coal-2 p-7 transition hover:border-gold/50">
              <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2c1 4-2 5-2 8a4 4 0 0 0 8 0c0-1-.5-2-1-2.5C17 9 18 10 18 12a6 6 0 0 1-12 0c0-4 4-6 6-10z" />
                <path d="M9 22h6" />
              </svg>
              <h3 class="mt-5 font-display text-2xl font-bold">Más Proteína</h3>
              <p class="mt-2 text-sm leading-relaxed text-cream-dim">125 g de proteína por burger para rendir el día y la noche. Con hierro, zinc y B12 para los días largos.</p>
            </div>
            <div class="reveal rounded-2xl border border-cream/10 bg-coal-2 p-7 transition hover:border-gold/50" style="transition-delay:60ms">
              <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z" />
                <path d="M9 14a3 3 0 0 0 3 3" />
              </svg>
              <h3 class="mt-5 font-display text-2xl font-bold">Menos Grasa</h3>
              <p class="mt-2 text-sm leading-relaxed text-cream-dim">Carne magra de rancho: todo el sabor, nada pesado. Hasta siete veces menos grasa que un corte de res.</p>
            </div>
            <div class="reveal rounded-2xl border border-cream/10 bg-coal-2 p-7 transition hover:border-gold/50" style="transition-delay:120ms">
              <svg viewBox="0 0 24 24" class="h-10 w-10 text-gold" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12V3a1 1 0 0 1 2 0v9a2.5 2.5 0 0 0 2.5 2.5c.8 0 1.5-.4 2-1V11a1 1 0 0 1 2 0v3.5c0 3-2.5 5.5-5.7 5.9l-3.6.4c-2.9.3-5.7-1.4-6.5-4.2l-1-3.3a1.6 1.6 0 0 1 2.6-1.5l1.2 1.7z" />
              </svg>
              <h3 class="mt-5 font-display text-2xl font-bold">Sabor Intenso</h3>
              <p class="mt-2 text-sm leading-relaxed text-cream-dim">Notas profundas y sellado smash que ninguna res clásica alcanza. Menos marmoleado, más sabor en cada bocado.</p>
            </div>
          </div>
        </div>

        <!-- Cara a cara: búfalo vs. res -->
        <div class="reveal mt-14 overflow-hidden rounded-2xl border border-gold/25 bg-coal-2">
          <div class="flex flex-wrap items-end justify-between gap-4 border-b border-cream/10 p-7 sm:p-10">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-gold">Cara a cara</p>
              <h3 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Búfalo contra res</h3>
            </div>
            <p class="max-w-xs text-sm leading-relaxed text-cream-dim">
              Promedios por cada 100 g de carne. La barra dorada es nuestro búfalo;
              la gris, un corte de res equivalente.
            </p>
          </div>
          <div class="divide-y divide-cream/10">
            {VS_RES.map((c) => {
              const max = Math.max(c.b, c.r);
              return (
                <div class="grid gap-4 p-7 sm:grid-cols-[13rem_1fr] sm:items-center sm:gap-8 sm:p-x-10">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-display text-lg font-bold">{c.k}</h4>
                      <span class="tnum rounded-full bg-gold/15 px-2.5 py-0.5 text-[11px] font-bold text-gold">
                        {diff(c.b, c.r)}
                      </span>
                    </div>
                    <p class="mt-1 text-[13px] leading-relaxed text-cream-dim">{c.d}</p>
                  </div>
                  <div class="space-y-2.5">
                    <div class="flex items-center gap-3">
                      <span class="w-14 shrink-0 text-[10px] font-bold uppercase tracking-[0.18em] text-gold">Búfalo</span>
                      <div class="h-2.5 flex-1 overflow-hidden rounded-full bg-coal-3">
                        <div class="h-full rounded-full bg-gradient-to-r from-gold-soft to-gold" style={`width:${Math.max(pct(c.b, max), 6)}%`}></div>
                      </div>
                      <span class="tnum w-24 shrink-0 text-right text-sm font-bold text-cream">
                        {c.b} <span class="text-[11px] font-normal text-smoke">{c.unit}</span>
                      </span>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="w-14 shrink-0 text-[10px] font-bold uppercase tracking-[0.18em] text-smoke">Res</span>
                      <div class="h-2.5 flex-1 overflow-hidden rounded-full bg-coal-3">
                        <div class="h-full rounded-full bg-cream/20" style={`width:${pct(c.r, max)}%`}></div>
                      </div>
                      <span class="tnum w-24 shrink-0 text-right text-sm text-cream-dim">
                        {c.r} <span class="text-[11px] text-smoke">{c.unit}</span>
                      </span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- ══════════ MENÚ ══════════ -->
      <section id="menu" class="scroll-mt-20 border-t border-cream/10 bg-coal-2/60">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
          <div class="reveal flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-gold">El core</p>
              <h2 class="mt-3 font-display text-4xl font-black sm:text-5xl">Menú RUMEN</h2>
              <p class="mt-3 max-w-lg text-cream-dim">Elige, personaliza y manda tu pedido por WhatsApp. Precios en MXN.</p>
            </div>
            <a
              href={MENU_APP}
              target="_blank"
              rel="noopener"
              class="rounded-full border border-gold/60 px-6 py-3 text-[12px] font-bold uppercase tracking-[0.14em] text-gold transition hover:bg-gold hover:text-coal"
            >
              Abrir menú interactivo ↗
            </a>
          </div>

          <!-- Tabs -->
          <div class="reveal mt-10 flex gap-2 overflow-x-auto pb-2" role="tablist" aria-label="Categorías del menú" id="tabs">
            {MENU.map((c, i) => (
              <button
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-cat={c.id}
                class:list={[
                  "shrink-0 rounded-full border px-5 py-2.5 text-[12px] font-bold uppercase tracking-[0.14em] transition",
                  i === 0
                    ? "border-gold bg-gold text-coal"
                    : "border-cream/20 text-cream-dim hover:border-gold/60 hover:text-gold",
                ]}
              >
                {c.name}
              </button>
            ))}
          </div>

          <!-- Categorías -->
          {MENU.map((cat, ci) => (
            <div class="menu-cat mt-8" data-cat-panel={cat.id} hidden={ci !== 0}>
              <p class="text-sm text-smoke">{cat.sub}</p>
              <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {cat.items.map((item) => (
                  <article
                    class:list={[
                      "group relative flex flex-col overflow-hidden rounded-2xl border bg-coal transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-20px_rgba(193,140,78,0.35)]",
                      item.featured ? "border-gold/60" : "border-cream/10 hover:border-gold/40",
                    ]}
                  >
                    {item.img ? (
                      <div class="grain relative h-52 overflow-hidden">
